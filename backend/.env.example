# ============ 创作工作台后端环境变量（示例，勿提交真实值）============
# 运行环境：preview | production | test（决定默认桶名/隔离策略）
APP_ENV=preview
PORT=8000

# 语义版本（自检页版本兼容性依据）
API_VERSION=1.4.0
MIN_CLIENT_VERSION=1.4.0
BUILD_SHA=local-dev

# 必须：JWT 签名密钥（生产请使用 >=32 字节随机串，例如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-secret

# 必须：浏览器可访问的 API 绝对地址（上传回调/下载授权展示与探针使用）
# 本地 Compose: http://localhost:8000   Vercel 前端: https://your-api.example.com
PUBLIC_BASE_URL=http://localhost:8000

# 必须：浏览器来源白名单（逗号分隔），不在白名单的跨域请求将被拒绝
# 本地 Vite/Trae 预览：http://localhost:5173,http://localhost:4173
# Vercel：https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# 必须：PostgreSQL（预览/正式使用不同数据库实例或不同库名）
DATABASE_URL=postgres://workbench:workbench@db:5432/workbench_preview

# 迁移策略：latest=启动自动迁移；可设 AUTO_MIGRATE=false 后手动 npm run migrate
MIGRATION_LEVEL=latest
AUTO_MIGRATE=true

# 必须：对象存储（MinIO/S3 兼容）
S3_ENDPOINT=minio
S3_INTERNAL_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=workbench
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=workbench-preview
# 浏览器访问的对外地址（预签名下载链接使用）
S3_PUBLIC_ENDPOINT=localhost
S3_PUBLIC_PORT=9000
S3_PRESIGN_TTL_SECONDS=300

# 持久队列 / worker
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_LEASE_MS=30000
QUEUE_HEARTBEAT_MS=10000
QUEUE_MAX_ATTEMPTS=3
WORKER_NAME=worker-1
WORKER_HEALTH_PORT=9101

# 验收演练：导出任务额外耗时（毫秒），用于验证部署换版在途任务续接
EXPORT_DELAY_MS=0
LOG_LEVEL=info
