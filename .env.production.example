APP_ENV=production
API_VERSION=1.0.0
CONTRACT_VERSION=2026.10.1
MIN_CLIENT_VERSION=1.0.0
# 生产独立数据库、队列、桶和回调域名；禁止指向 preview
DATABASE_URL=postgresql://workbench:strong-password@prod-db.internal:5432/workbench
REDIS_URL=redis://prod-redis.internal:6379
S3_ENDPOINT=http://prod-minio.internal:9000
S3_PUBLIC_ENDPOINT=https://assets.your-domain.com
S3_BUCKET=creator-workbench-production
CORS_ORIGIN=https://app.your-domain.com
CALLBACK_BASE_URL=https://api.your-domain.com
QUEUE_PREFIX=creator-workbench-prod
SEED_TENANT_SLUG=production-tenant
# Secrets must be stored in the production secret manager.
