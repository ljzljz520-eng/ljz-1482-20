# Copy to .env. Never commit real secrets.
APP_ENV=development
PORT=3001
API_VERSION=1.0.0
CONTRACT_VERSION=2026.10.1
MIN_CLIENT_VERSION=1.0.0
JWT_SECRET=change-me-minimum-32-random-characters
CALLBACK_SECRET=change-me-minimum-32-random-characters

POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench-local-password
DATABASE_URL=postgresql://workbench:workbench-local-password@db:5432/workbench?schema=public

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creator-workbench
S3_ACCESS_KEY_ID=workbench-access-key
S3_SECRET_ACCESS_KEY=workbench-secret-key
S3_PRESIGN_TTL_SECONDS=600

CALLBACK_BASE_URL=http://backend:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4173
QUEUE_PREFIX=creator-workbench-dev
SEED_TENANT_SLUG=demo-studio
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=Workbench@2026
SEED_TENANT_NAME=演示创作工作室
