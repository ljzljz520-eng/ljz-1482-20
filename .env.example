# 根目录 docker compose 变量示例：复制为 .env（.env 已被 gitignore，不会提交）
APP_ENV=preview
FRONTEND_PORT=3000
API_PORT=8000
DB_PORT=5432
S3_HOST_PORT=9000

POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench
POSTGRES_DB=workbench_preview

S3_ACCESS_KEY=workbench
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=workbench-preview
S3_PUBLIC_ENDPOINT=localhost
S3_PUBLIC_PORT=9000
S3_PRESIGN_TTL_SECONDS=300

JWT_SECRET=dev-only-jwt-secret-please-change-0123456789
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# 部署换版在途任务演练时可临时加大
EXPORT_DELAY_MS=0
