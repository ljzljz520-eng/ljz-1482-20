APP_ENV=preview
API_VERSION=1.0.0
CONTRACT_VERSION=2026.10.1
MIN_CLIENT_VERSION=1.0.0
# 指向预览专用 Postgres/Redis/Object Storage，不能复用生产库
DATABASE_URL=postgresql://preview-user:strong-password@preview-db.example.internal:5432/workbench_preview
REDIS_URL=redis://preview-redis.example.internal:6379
S3_ENDPOINT=http://preview-minio.example.internal:9000
S3_PUBLIC_ENDPOINT=https://preview-assets.example.com
S3_BUCKET=creator-workbench-preview
CORS_ORIGIN=https://your-trae-preview-host,https://your-vercel-preview-app.vercel.app
CALLBACK_BASE_URL=https://your-preview-api.example.com
QUEUE_PREFIX=creator-workbench-preview
# JWT_SECRET, CALLBACK_SECRET, S3 keys are injected by the deployment platform.
SEED_TENANT_SLUG=preview-studio
SEED_USER_EMAIL=admin@preview.example
